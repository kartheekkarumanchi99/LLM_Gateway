# Copy to .env at the repo root and fill in. Never commit .env.

# ---- Database (Neon Postgres) ----
# Pooled connection (used by the gateway's pg Pool at runtime).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct/unpooled connection (used by drizzle-kit for migrations/push).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Providers (your personal keys) ----
# Add a provider's key here to light up ALL of its models with NO code changes — routing,
# key resolution, and executability read from the shared provider catalog
# (packages/db/src/providers-catalog.ts). Restart the gateway after adding a key. Leave a
# provider blank to keep it disabled.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""
MISTRAL_API_KEY=""
GEMINI_API_KEY=""
MOONSHOT_API_KEY=""
PERPLEXITY_API_KEY=""

# ---- BYOK secret encryption (required to store provider keys) ----
# Any string; it is hashed to a 32-byte AES-256-GCM key. Keep it stable and secret.
BYOK_ENCRYPTION_KEY=""

# Optional base-URL overrides (leave unset for defaults; useful for proxies/gateways)
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# XAI_BASE_URL="https://api.x.ai/v1"
# MISTRAL_BASE_URL="https://api.mistral.ai/v1"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# MOONSHOT_BASE_URL="https://api.moonshot.ai/v1"
# PERPLEXITY_BASE_URL="https://api.perplexity.ai"

# ---- Gateway ----
PORT="8787"
NODE_ENV="development"

# ---- Web dashboard auth ----
# When "true", the dashboard requires sign-in and redirects to /login.
# Leave unset for local single-tenant/demo mode (uses the seeded demo org).
AUTH_REQUIRED=""
